{
  "name": "civicfix-platform",
  "version": "0.1.0",
  "description": "Three-tier community issue reporting and resolution platform by CubIC ClouD",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "backend:check": "npm --prefix backend run check",
    "frontend:build": "npm --prefix frontend run build"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
