{
  "name": "@civicfix/frontend",
  "version": "0.1.0",
  "description": "CivicFix Platform frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
